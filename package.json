{
  "name": "golden-example",
  "scripts": {
    "dev": "NODE_ENV=development bun run --hot src/index.ts",
    "db:generate": "bunx drizzle-kit generate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:setup": "bun run db:generate && bun run db:push",
    "dev:postgres": "USE_POSTGRES=true bun run dev",
    "dev:memory": "USE_POSTGRES=false bun run dev"
  },
  "dependencies": {
    "@graphql-tools/schema": "^10.0.18",
    "@hono/swagger-ui": "^0.5.0",
    "@hono/zod-openapi": "^0.18.4",
    "@hono/zod-validator": "^0.4.3",
    "@scalar/hono-api-reference": "^0.5.174",
    "drizzle-kit": "^0.30.5",
    "drizzle-orm": "^0.40.0",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.12.0",
    "hono": "^4.7.2",
    "hono-openapi": "^0.4.4",
    "pg": "^8.14.0",
    "zod": "^3.24.2",
    "zod-openapi": "^4.2.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.11.11"
  }
}