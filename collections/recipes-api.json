{
  "info": {
    "name": "Recipes API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "apiKey",
      "value": "default-api-key-123",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "123e4567-e89b-12d3-a456-426614174000",
      "type": "string"
    },
    {
      "key": "recipeId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "List Recipes - Initial",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.be.an('array');",
              "    // Store initial count for later comparison",
              "    pm.environment.set('initialRecipeCount', response.length);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create Recipe",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"title\": \"Spaghetti Carbonara\",\n    \"ingredients\": [\"spaghetti\", \"eggs\", \"pecorino cheese\", \"guanciale\", \"black pepper\"],\n    \"instructions\": \"1. Cook pasta\\n2. Prepare sauce\\n3. Mix and serve\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function() {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has correct recipe data', function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.property('id');",
              "    // Set the recipeId variable for subsequent requests",
              "    pm.environment.set('recipeId', response.id);",
              "    pm.collectionVariables.set('recipeId', response.id);",
              "});",
              "",
              "// Automatically move to the next request",
              "postman.setNextRequest('Get Recipe');"
            ]
          }
        }
      ]
    },
    {
      "name": "Get Recipe",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes/{{recipeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes",
            "{{recipeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Recipe has correct data', function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.property('id');",
              "    pm.expect(response.id).to.equal(pm.environment.get('recipeId'));",
              "    pm.expect(response.title).to.equal('Spaghetti Carbonara');",
              "});",
              "",
              "// Automatically move to the next request",
              "postman.setNextRequest('Search Recipes');"
            ]
          }
        }
      ]
    },
    {
      "name": "Search Recipes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes?q=carbonara",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes"
          ],
          "query": [
            {
              "key": "q",
              "value": "carbonara"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array with our recipe', function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.be.an('array');",
              "    ",
              "    // Check if our created recipe is in the search results",
              "    const found = response.some(recipe => recipe.id === pm.environment.get('recipeId'));",
              "    pm.expect(found).to.be.true;",
              "});",
              "",
              "// Automatically move to the next request",
              "postman.setNextRequest('Get User\\'s Recipes');"
            ]
          }
        }
      ]
    },
    {
      "name": "Get User's Recipes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes?userId={{userId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes"
          ],
          "query": [
            {
              "key": "userId",
              "value": "{{userId}}"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array with user\\'s recipes', function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.be.an('array');",
              "    ",
              "    // Check if our created recipe is in the user's recipes",
              "    const found = response.some(recipe => recipe.id === pm.environment.get('recipeId'));",
              "    pm.expect(found).to.be.true;",
              "});",
              "",
              "// Automatically move to the next request",
              "postman.setNextRequest('Update Recipe');"
            ]
          }
        }
      ]
    },
    {
      "name": "Update Recipe",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes/{{recipeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes",
            "{{recipeId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"title\": \"Updated Carbonara\",\n    \"ingredients\": [\"spaghetti\", \"eggs\", \"pecorino cheese\", \"pancetta\", \"black pepper\"],\n    \"instructions\": \"1. Cook pasta al dente\\n2. Prepare sauce\\n3. Combine and serve immediately\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Recipe was updated correctly', function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.property('id');",
              "    pm.expect(response.id).to.equal(pm.environment.get('recipeId'));",
              "    pm.expect(response.title).to.equal('Updated Carbonara');",
              "});",
              "",
              "// Automatically move to the next request",
              "postman.setNextRequest('Verify Updated Recipe');"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify Updated Recipe",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes/{{recipeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes",
            "{{recipeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Recipe has updated data', function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.have.property('id');",
              "    pm.expect(response.id).to.equal(pm.environment.get('recipeId'));",
              "    pm.expect(response.title).to.equal('Updated Carbonara');",
              "    pm.expect(response.ingredients).to.include('pancetta');",
              "});",
              "",
              "// Automatically move to the next request",
              "postman.setNextRequest('Delete Recipe');"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete Recipe",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes/{{recipeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes",
            "{{recipeId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Automatically move to the next request",
              "postman.setNextRequest('Verify Deletion');"
            ]
          }
        }
      ]
    },
    {
      "name": "Verify Deletion",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes/{{recipeId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes",
            "{{recipeId}}"
          ],
          "query": []
        },
        "body": {}
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Recipe should be deleted (404)', function() {",
              "    pm.response.to.have.status(404);",
              "});",
              "",
              "// Automatically move to the next request",
              "postman.setNextRequest('Verify DB Cleanup');"
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
      ]
    },
    {
      "name": "Verify DB Cleanup",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/recipes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "recipes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function() {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Recipe count should be back to initial state', function() {",
              "    const response = pm.response.json();",
              "    pm.expect(response).to.be.an('array');",
              "    ",
              "    // Compare with initial count to ensure we're back to where we started",
              "    const initialCount = parseInt(pm.environment.get('initialRecipeCount') || '0');",
              "    pm.expect(response.length).to.equal(initialCount);",
              "    ",
              "    // Verify our specific recipe is not there",
              "    const found = response.some(recipe => recipe.id === pm.environment.get('recipeId'));",
              "    pm.expect(found).to.be.false;",
              "});",
              "",
              "// Clean up environment variables",
              "pm.environment.unset('recipeId');",
              "pm.environment.unset('initialRecipeCount');",
              "",
              "// End the collection run",
              "postman.setNextRequest(null);"
            ]
          }
        }
      ]
    }
  ]
}