{
  "info": {
    "name": "_ status API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "API_KEY",
      "value": "default-api-key-123",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Get Status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{API_KEY}}",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{BASE_URL}}/status",
          "host": [
            "{{BASE_URL}}"
          ],
          "path": [
            "status"
          ],
          "query": []
        },
        "body": {}
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function() {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an object with services', function() {",
              "  const response = pm.response.json();",
              "  pm.expect(response).to.be.an('object');",
              "  pm.expect(response.services).to.be.an('object');",
              "  pm.expect(response.services).to.not.be.null;",
              "});",
              "",
              "pm.test('Redis service has valid status', function() {",
              "  const response = pm.response.json();",
              "  const validStatuses = ['success', 'failure', 'not connected'];",
              "  pm.expect(response.services.redis).to.be.an('object');",
              "  pm.expect(response.services.redis.status).to.be.a('string');",
              "  pm.expect(validStatuses).to.include(response.services.redis.status, `Redis status should be one of: ${validStatuses.join(', ')}`);",
              "});",
              "",
              "pm.test('Postgres service has valid status', function() {",
              "  const response = pm.response.json();",
              "  const validStatuses = ['success', 'failure', 'not connected'];",
              "  pm.expect(response.services.postgres).to.be.an('object');",
              "  pm.expect(response.services.postgres.status).to.be.a('string');",
              "  pm.expect(validStatuses).to.include(response.services.postgres.status, `Postgres status should be one of: ${validStatuses.join(', ')}`);",
              "});",
              "",
              "pm.test('Postgres type has valid value', function() {",
              "  const response = pm.response.json();",
              "  const validDbTypes = ['in-memory', 'postgres'];",
              "  pm.expect(response.services.postgres.type).to.be.a('string');",
              "  pm.expect(validDbTypes).to.include(response.services.postgres.type, `Postgres type should be one of: ${validDbTypes.join(', ')}`);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}