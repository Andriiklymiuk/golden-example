          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response has users data', function() {",
                  "    const response = pm.response.json();",
                  "    pm.expect(response.data).to.have.property('users');",
                  "    pm.expect(response.data.users).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('User objects have correct structure', function() {",
                  "    const response = pm.response.json();",
                  "    if (response.data.users.length > 0) {",
                  "        const user = response.data.users[0];",
                  "        pm.expect(user).to.have.property('id');",
                  "        pm.expect(user).to.have.property('name');",
                  "        pm.expect(user).to.have.property('email');",
                  "        pm.expect(user).to.have.property('createdAt');",
                  "        pm.expect(user).to.have.property('updatedAt');",
                  "        pm.expect(user).to.have.property('recipes');",
                  "    }",
                  "});"
                ]
              }
            }
          ]
